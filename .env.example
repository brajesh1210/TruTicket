# ============================================================================
# TruTicket — Environment Variables (Production Ready)
# ============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ---------- Supabase ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---------- Authentication ----------
JWT_SECRET=your-super-secret-jwt-key
NEXTAUTH_SECRET=your-nextauth-secret

# ---------- Blockchain (Polygon Amoy Testnet) ----------
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_AMOY_PRIVATE_KEY=0x-your-private-key
CONTRACT_ADDRESS=0x-your-deployed-contract-address
CHAIN_ID=80002

# ---------- Payments (Razorpay Test Mode) ----------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---------- ML Service ----------
ML_SERVICE_URL=http://localhost:8000
ML_MODEL_PATH=./services/ml/model/risk_model.pkl

# ---------- n8n ----------
N8N_HOST=http://localhost:5678
N8N_API_KEY=your-n8n-api-key

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------- Feature Flags ----------
NEXT_PUBLIC_ENABLE_FAIRQUEUE=true
NEXT_PUBLIC_ENABLE_RESALE=true
NEXT_PUBLIC_ENABLE_GROUP_TICKETS=true
NEXT_PUBLIC_ENABLE_ML_RISK_SCORING=true