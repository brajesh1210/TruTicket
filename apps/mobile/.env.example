# Copy to .env for local runs only (never commit .env).
# Cloud builds (EAS) do NOT read this file. Set the values with scripts/set-mobile-env-dev.ps1.

# Demo UI (demo sign-in button, demo gate path). The server only accepts the demo code on DEV.
# MUST be false in production builds.
EXPO_PUBLIC_DEMO_MODE=true

# Google OAuth Web client ID (public identifier, not a secret).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# DEV Supabase project (truticket-dev). Public values only. Never the production project or a service key.
EXPO_PUBLIC_SUPABASE_URL=https://oviqjnzlgbkmggytaqao.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The published event the gate scanner admits for (event id from the events list).
EXPO_PUBLIC_GATE_EVENT_ID=
