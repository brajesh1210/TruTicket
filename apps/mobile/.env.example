# Copy to .env (local only, never commit .env).
# Demo accounts + demo OTP 123456. MUST be false in production builds.
EXPO_PUBLIC_DEMO_MODE=true
# Google OAuth Web client ID (public identifier, not a secret).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Phase 2: Supabase project URL and anon key (public, safe for the app).
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
