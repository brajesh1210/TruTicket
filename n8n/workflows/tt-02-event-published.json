{
  "id": "tt-02-event-published",
  "name": "TruTicket 02 - Event published",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/events?status=eq.published&updatedAt=gte.{{ $now.minus({ days: 1 }).toUTC().toISO() }}&select=id,title,startAt,organizers(userId)&limit=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Read source rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst r = $json;\nif (!r || !r.id) return [];\nconst recipient = (r.organizers && r.organizers.userId) || null;\nif (!recipient) return [];\nreturn [{ json: { row: {\n  kind: 'EVENT_PUBLISHED',\n  dedupeKey: 'EVENT_PUBLISHED:' + r.id,\n  recipientId: recipient,\n  payload: { event_id: r.id, title: r.title, start_at: r.startAt }\n} } }];\n"
      },
      "name": "Build outbox row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/notification_outbox?on_conflict=dedupeKey",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=ignore-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ [$json.row] }}",
        "options": {}
      },
      "name": "Insert outbox row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        0
      ]
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Read source rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read source rows": {
      "main": [
        [
          {
            "node": "Build outbox row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build outbox row": {
      "main": [
        [
          {
            "node": "Insert outbox row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "note": "Producer. Tells the organiser their event is live (one per event)."
  },
  "tags": [],
  "pinData": {}
}
