// TruTicket Database Schema (Supabase PostgreSQL)
// 18 Models (mapped to 18 tables) — Production Ready

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ATTENDEE
  ORGANIZER
  GATE_STAFF
  FRAUD_REVIEWER
  PLATFORM_ADMIN
}

enum TicketStatus {
  CREATED
  AVAILABLE
  ISSUED_ACTIVE
  ISSUED_UNASSIGNED_GROUP
  LISTED
  TRANSFERRED
  REDEEMED
  REVOKED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  CREATED
  RESERVED
  PAYMENT_PENDING
  PAID
  TICKET_ISSUED
  PAYMENT_FAILED
  RESERVATION_EXPIRED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum ResaleListingStatus {
  DRAFT
  ACTIVE
  PURCHASE_PENDING
  TRANSFER_PENDING
  COMPLETED
  CANCELLED
  EXPIRED
  PAYMENT_FAILED
  TRANSFER_FAILED
  DISPUTED
}

enum QueueAllocationStatus {
  JOINED
  SELECTED
  ADMITTED
  EXPIRED
  CANCELLED
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
}

model Profile {
  id                        String   @id @default(uuid()) @db.Uuid
  email                     String   @unique
  phone                     String?
  passwordHash              String?
  role                      UserRole @default(ATTENDEE)
  status                    String   @default("active")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relations to Profile (opposite sides defined in related models)
  organizer                 Organizer?   @relation("OrganizerUser")
  tickets                   Ticket[]     @relation("TicketCurrentOwner")
  orders                    Order[]      @relation("OrderBuyer")
  resaleListings            ResaleListing[] @relation("ResaleListingSeller")
  transfersFrom             Transfer[]   @relation("TransferFromOwner")
  transfersTo               Transfer[]   @relation("TransferToOwner")
  fraudEvents               FraudEvent[] @relation("FraudEventUser")
  fraudEventsReviewed       FraudEvent[] @relation("FraudEventReviewer")
  queueEntries              QueueEntry[] @relation("QueueEntryUser")
  inventoryReservations     InventoryReservation[] @relation("InventoryReservationUser")
  auditLogs                 AuditLog[]   @relation("AuditLogActor")

  // Relations to GroupTicket (opposite sides defined in GroupTicket)
  groupTicketsManaged       GroupTicket[] @relation("GroupTicketManager")
  groupTicketsMember        GroupTicket[] @relation("GroupTicketMember")

  @@map("profiles")
}

model Organizer {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  organizationName  String
  verificationStatus String @default("pending")
  createdAt         DateTime @default(now())

  user              Profile   @relation("OrganizerUser", fields: [userId], references: [id], onDelete: Cascade)
  events            Event[]   @relation("OrganizerEvents")

  @@map("organizers")
}

model Event {
  id                String      @id @default(uuid()) @db.Uuid
  organizerId       String      @db.Uuid
  title             String
  description       String?
  venue             String
  timezone          String      @default("Asia/Kolkata")
  startAt           DateTime
  endAt             DateTime
  coverImageUrl     String?
  categories        String[]
  terms             String?
  status            String      @default("draft")
  contractAddress   String?
  chainId           Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organizer         Organizer   @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  ticketTypes       TicketType[] @relation("EventTicketTypes")
  tickets           Ticket[]    @relation("EventTickets")
  orders            Order[]     @relation("EventOrders")
  queueEntries      QueueEntry[] @relation("EventQueueEntries")
  redemptions       Redemption[] @relation("EventRedemptions")
  scanners          Scanner[]   @relation("EventScanners")
  inventoryReservations InventoryReservation[] @relation("EventInventoryReservations")

  @@map("events")
}

model TicketType {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @db.Uuid
  name            String
  faceValueMinor  Int
  currency        String   @default("INR")
  quantity        Int
  saleStart       DateTime
  saleEnd         DateTime
  perAccountLimit Int      @default(4)
  refundRules     String?
  createdAt       DateTime @default(now())

  event           Event    @relation("EventTicketTypes", fields: [eventId], references: [id], onDelete: Cascade)
  tickets         Ticket[] @relation("TicketTypeTickets")
  orderItems      OrderItem[] @relation("TicketTypeOrderItems")
  inventoryReservations InventoryReservation[] @relation("TicketTypeInventoryReservations")

  @@map("ticket_types")
}

model Ticket {
  id              String        @id @default(uuid()) @db.Uuid
  eventId         String        @db.Uuid
  ticketTypeId    String        @db.Uuid
  tokenId         String?
  currentOwnerId  String        @db.Uuid
  faceValueMinor  Int
  status          TicketStatus  @default(CREATED)
  transferCount   Int           @default(0)
  policyVersion   Int           @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event         @relation("EventTickets", fields: [eventId], references: [id], onDelete: Cascade)
  ticketType      TicketType    @relation("TicketTypeTickets", fields: [ticketTypeId], references: [id], onDelete: Cascade)
  currentOwner    Profile       @relation("TicketCurrentOwner", fields: [currentOwnerId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]   @relation("TicketOrderItems")
  resaleListings  ResaleListing[] @relation("TicketResaleListings")
  transfers       Transfer[]    @relation("TicketTransfers")
  qrCredentials   QrCredential[] @relation("TicketQrCredentials")
  redemptions     Redemption[]  @relation("TicketRedemptions")
  groupTickets    GroupTicket[]

  @@map("tickets")
}

model Order {
  id              String       @id @default(uuid()) @db.Uuid
  buyerId         String       @db.Uuid
  eventId         String       @db.Uuid
  status          OrderStatus  @default(CREATED)
  totalMinor      Int
  currency        String       @default("INR")
  idempotencyKey  String       @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buyer           Profile      @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  event           Event        @relation("EventOrders", fields: [eventId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]  @relation("OrderOrderItems")
  payments        Payment[]    @relation("OrderPayments")
  groupTickets    GroupTicket[]

  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  ticketTypeId   String   @db.Uuid
  ticketId       String   @db.Uuid
  unitPriceMinor Int

  order          Order    @relation("OrderOrderItems", fields: [orderId], references: [id], onDelete: Cascade)
  ticketType     TicketType @relation("TicketTypeOrderItems", fields: [ticketTypeId], references: [id], onDelete: Cascade)
  ticket         Ticket   @relation("TicketOrderItems", fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @db.Uuid
  provider          String   @default("razorpay")
  providerPaymentId String?
  status            String   @default("pending")
  signatureVerified Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order             Order    @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model InventoryReservation {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @db.Uuid
  ticketTypeId String   @db.Uuid
  userId       String   @db.Uuid
  quantity     Int
  expiresAt    DateTime
  status       String   @default("active")

  event        Event    @relation("EventInventoryReservations", fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType @relation("TicketTypeInventoryReservations", fields: [ticketTypeId], references: [id], onDelete: Cascade)
  user         Profile  @relation("InventoryReservationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("inventory_reservations")
}

model QueueEntry {
  id                  String              @id @default(uuid()) @db.Uuid
  eventId             String            @db.Uuid
  userId              String?           @db.Uuid
  sessionId           String?
  joinedAt            DateTime          @default(now())
  allocationStatus    QueueAllocationStatus @default(JOINED)
  admissionExpiresAt  DateTime?
  createdAt           DateTime @default(now())

  event               Event   @relation("EventQueueEntries", fields: [eventId], references: [id], onDelete: Cascade)
  user                Profile? @relation("QueueEntryUser", fields: [userId], references: [id], onDelete: SetNull)

  @@map("queue_entries")
}

model ResaleListing {
  id              String               @id @default(uuid()) @db.Uuid
  ticketId        String               @db.Uuid
  sellerId        String               @db.Uuid
  askMinor        Int
  status          ResaleListingStatus  @default(DRAFT)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticket          Ticket   @relation("TicketResaleListings", fields: [ticketId], references: [id], onDelete: Cascade)
  seller          Profile  @relation("ResaleListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("resale_listings")
}

model Transfer {
  id              String   @id @default(uuid()) @db.Uuid
  ticketId        String   @db.Uuid
  fromOwnerId     String   @db.Uuid
  toOwnerId       String   @db.Uuid
  priceMinor      Int
  txHash          String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  ticket          Ticket      @relation("TicketTransfers", fields: [ticketId], references: [id], onDelete: Cascade)
  fromOwner       Profile     @relation("TransferFromOwner", fields: [fromOwnerId], references: [id], onDelete: Cascade)
  toOwner         Profile     @relation("TransferToOwner", fields: [toOwnerId], references: [id], onDelete: Cascade)

  @@map("transfers")
}

model QrCredential {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  nonceHash   String
  expiresAt   DateTime
  keyId       String
  consumedAt  DateTime?
  status      String   @default("active")
  createdAt   DateTime @default(now())

  ticket      Ticket   @relation("TicketQrCredentials", fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("qr_credentials")
}

model Redemption {
  id            String   @id @default(uuid()) @db.Uuid
  ticketId      String   @db.Uuid
  eventId       String   @db.Uuid
  scannerId     String   @db.Uuid
  redeemedAt    DateTime @default(now())
  result        String
  idempotencyKey String  @unique

  ticket        Ticket   @relation("TicketRedemptions", fields: [ticketId], references: [id], onDelete: Cascade)
  event         Event    @relation("EventRedemptions", fields: [eventId], references: [id], onDelete: Cascade)
  scanner       Scanner  @relation("ScannerRedemptions", fields: [scannerId], references: [id], onDelete: Cascade)

  @@map("redemptions")
}

model Scanner {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @db.Uuid
  deviceName      String
  publicKey       String?
  deviceSecretRef String?
  status          String   @default("active")
  createdAt       DateTime @default(now())

  event           Event      @relation("EventScanners", fields: [eventId], references: [id], onDelete: Cascade)
  redemptions     Redemption[] @relation("ScannerRedemptions")

  @@map("scanners")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  objectType String
  objectId   String?
  outcome    String
  timestamp  DateTime @default(now())

  actor      Profile? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model FraudEvent {
  id           String   @id @default(uuid()) @db.Uuid
  sessionId    String   @unique
  userId       String?  @db.Uuid
  riskScore    Int      @default(0)
  riskBand     RiskBand @default(LOW)
  reasonCodes  String[] @default([])
  status       String   @default("open")
  reviewedBy   String?  @db.Uuid
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  user         Profile?   @relation("FraudEventUser", fields: [userId], references: [id], onDelete: SetNull)
  reviewer     Profile?   @relation("FraudEventReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("fraud_events")
}

model GroupTicket {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @db.Uuid
  managerId    String   @db.Uuid
  memberId     String?  @db.Uuid
  ticketId     String   @db.Uuid
  status       String   @default("unassigned")
  claimToken   String?
  inviteExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  manager      Profile   @relation("GroupTicketManager", fields: [managerId], references: [id], onDelete: Cascade)
  member       Profile?  @relation("GroupTicketMember", fields: [memberId], references: [id], onDelete: SetNull)
  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("group_tickets")
}